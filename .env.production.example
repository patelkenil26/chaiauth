# Copy this to .env.production ON THE SERVER (never commit the real file).
#   cp .env.production.example .env.production
# Compose reads it for both substitution and the api container's environment.

# ---- Domains (point both A records at the Oracle VM public IP) ----
WEB_DOMAIN=chaiauth.example.com
API_DOMAIN=api.chaiauth.example.com

# ---- Postgres (used to build DATABASE_URL in docker-compose.prod.yml) ----
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---- Secrets. Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Email (Resend). Verify your domain first, or emails only reach your own address ----
RESEND_API_KEY=
EMAIL_FROM=ChaiAuth <noreply@example.com>

# ---- Social login (callback: https://<API_DOMAIN>/api/auth/providers/<google|github>/callback) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Cloudflare Turnstile (real secret key for your domain) ----
TURNSTILE_SECRET_KEY=

LOGGER_LEVEL=info

# ---- Legacy template vars. The API refuses to boot if these are missing (packages/services) ----
# Any non-empty placeholder is fine; they are not used for the real Google login above.
GOOGLE_OAUTH_CLIENT_ID=unused
GOOGLE_OAUTH_CLIENT_SECRET=unused
GOOGLE_OAUTH_REDIRECT_URI=https://api.chaiauth.example.com/unused

# ---- Shared ----
NODE_ENV=development
LOGGER_LEVEL=debug

# ---- API (apps/api) ----
PORT=8000
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# JWT secrets: min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# ---- Database (packages/database) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chaiauth

# ---- Email (Resend). Empty key = emails are logged to console ----
RESEND_API_KEY=
EMAIL_FROM=ChaiAuth <onboarding@resend.dev>

# ---- Social providers ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Anti-bot (Cloudflare Turnstile) ----
TURNSTILE_SECRET_KEY=

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Legacy template vars (packages/services Google client; removed when auth module lands) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
